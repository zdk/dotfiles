defaults
auth on
tls on
tls_starttls on
# macOS ships a system trust store here. The old /usr/local/etc/openssl path
# was Intel-Homebrew-only and does not exist on Apple Silicon.
tls_trust_file /etc/ssl/cert.pem

account warachet
host smtp.gmail.com
port 587
protocol smtp
from warachet@cybernetes.co
user warachet@cybernetes.co
# Read the app password from the login keychain instead of storing it here.
# Create the entry once with:
#   security add-internet-password -a warachet -s smtp.gmail.com \
#       -r smtp -P 587 -w '<gmail-app-password>' -U
passwordeval security find-internet-password -a warachet -s smtp.gmail.com -w

account default : warachet
